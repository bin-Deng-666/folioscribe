# Copy to .env, fill in locally, then: set -a; source .env; set +a
OCR_AGENT_API_KEY=
OCR_AGENT_BASE_URL=
OCR_AGENT_MODEL=
OCR_AGENT_TIMEOUT_SECONDS=180
OCR_AGENT_MAX_OUTPUT_TOKENS=16384
OCR_AGENT_REASONING_EFFORT=minimal
OCR_AGENT_VISION=0
OCR_AGENT_DOCUMENT_ROOT=data/annotation
# Optional external DocFusion schema directory:
DOCPARSE_SCHEMA_ROOT=
# Optional local AnyDoc package directory:
ANYDOC_PACKAGE_DIR=
