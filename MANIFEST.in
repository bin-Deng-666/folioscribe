include README.md README.zh-CN.md CONTRIBUTING.md ROADMAP.md THIRD_PARTY_NOTICES.md LICENSE .env.example .editorconfig uv.lock
recursive-include components *.py *.md *.json *.html *.js *.css *.png
recursive-include examples *.py *.json
recursive-include tests *.py
recursive-include benchmarks *.py
recursive-include scripts *.py *.sh
recursive-include docs *.md *.json *.png
recursive-include .github *.yml
exclude .env
global-exclude *.py[cod] .DS_Store
prune data
prune .venv
prune .model-envs
